# Copy to .env and fill in values. Never commit .env.

# AI provider selection — set to "claude" or "gemini"
AI_PROVIDER=claude

# API key for the chosen provider
# Claude: get from https://console.anthropic.com
# Gemini: get from https://aistudio.google.com
AI_API_KEY=

# Next.js → FastAPI proxy (local dev: leave as default)
# On Vercel: set this to http://YOUR_ORACLE_IP:8000
FASTAPI_BASE_URL=http://127.0.0.1:8000
